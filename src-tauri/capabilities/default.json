{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capabilities for Dynamic Markdown Dock",
  "windows": ["dock"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-focus",
    "core:window:allow-is-focused",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "log:default"
  ]
}
